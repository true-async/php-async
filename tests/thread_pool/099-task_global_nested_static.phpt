--TEST--
ThreadPool: the static of a nested closure keeps its own string (arena-block reuse)
--SKIPIF--
<?php
if (!PHP_ZTS) die('skip ZTS required');
if (!class_exists('Async\ThreadPool')) die('skip ThreadPool not available');
?>
--FILE--
<?php

use Async\ThreadPool;
use function Async\spawn;
use function Async\await;

// The static's string is longer than an arena block, so it gets a malloc block
// of its own; the next snapshot carries a literal of the same length, and libc
// hands it the freed block. A reader that still points into the old block sees
// the impostor.
spawn(function() {
    $pool = new ThreadPool(workers: 1, coroutine: true);

    await($pool->submit(static function() {
        $GLOBALS['v'] = (static function() {
            static $seed = 'seed-';
            return $seed;
        })();

        return 'stored';
    }));

    await($pool->submit(static function() {
        $x = '';
        return strlen($x);
    }));

    $v = await($pool->submit(static fn() => $GLOBALS['v'] ?? 'gone'));
    var_dump(is_string($v) ? substr($v, 0, 10) . '|' . strlen($v) : $v);

    $pool->close();
    echo "Done\n";
});
?>
--EXPECT--
string(16) "seed-aaaaa|70005"
Done
